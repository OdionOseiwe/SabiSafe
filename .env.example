# ---- Database ----

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ---- Auth ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- NEAR AI Cloud (private, verifiable AI) ----

NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_SIGNING_ALGO=ed25519
NEAR_AI_E2EE=true
NEAR_AI_VERIFY_RESPONSES=true
NEAR_AI_PRIVATE_BY_DEFAULT=true
NEAR_AI_REDACT_BEFORE_SAVE=true
NEAR_AI_MAX_OUTPUT_TOKENS=900

# ---- DNS fallback for attestation hosts ----

DNS_FALLBACK_HOSTS=nras.attestation.nvidia.com,api.trustedservices.intel.com
DNS_FALLBACK_SERVERS=1.1.1.1,8.8.8.8

# ---- Aurora testnet (EVM) ----
# Aurora testnet chain ID is 1313161555 (0x4e454153).
AURORA_CHAIN_ID=1313161555
AURORA_RPC_URL=https://testnet.aurora.dev
AURORA_REGISTRY_ADDRESS=
AURORA_EXPLORER_URL=https://explorer.aurora.dev
AURORA_ACTIVITY_URL=https://explorer.aurora.dev/api/v2
AURORA_FAUCET_URL=https://aurora.dev/faucet

# ---- App ----
CLIENT_URL=http://localhost:5174
CORS_ORIGINS=
PORT=3001
NODE_ENV=development
COOKIE_SECURE=false

COOKIE_SAME_SITE=lax
TRANSACTION_LARGE_AMOUNT_ETH=0.001
AI_RATE_LIMIT_WINDOW_MINUTES=10
AI_RATE_LIMIT_MAX=30


